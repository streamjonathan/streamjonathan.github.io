    <li><a href="/feed/">RSS feed</a></li>
  </ul>
  <form id="newsletter-form">
    <label for="newsletter-email">Get new writing by email</label>
    <input id="newsletter-email" name="email" type="email" placeholder="you@example.com" required>
    <button type="submit">Sign up</button>
  </form>
  <p id="newsletter-note">Newsletter signup opens soon — for now, Substack is the best place to follow along.</p>
</section>

<h2>Writing</h2>
<ul>
{% for post in collections.publishedPosts | reverse %}
  <li><a href="{{ post.url }}">{{ post.data.title }}</a> — {{ post.date | readableDate }}</li>
{% endfor %}
</ul>

<h2>Pages</h2>
<ul>
{% for p in collections.pages | sort(false, false, "data.title") %}
  {% if p.data.slug != "sample-page" %}
  <li><a href="{{ p.url }}">{{ p.data.title }}</a></li>
  {% endif %}
{% endfor %}
</ul>


---
title: "Daily Poems"
slug: mind-poems
pageStylesheet: /css/mind-poems.css?v=4
pageScript: /js/mind-poems.js?v=3
---

{# One poem a day — but only days with a poem are "today". If today has
   a poem, it shows with "Today's poem". If not (only days 2–7 have
   poems so far), the latest poem shows instead, labelled with its date,
   so the page never shows a stale "today". JS re-picks from the
   reader's own clock on load; the poem below is the build-date default,
   so the page still shows a poem with JS off. #}
{% set todayNum = page.date.getDate() %}
{% set todayPoem = none %}
{% for p in mindPoems %}{% if p.day == todayNum %}{% set todayPoem = p %}{% endif %}{% endfor %}
{% set defaultPoem = todayPoem if todayPoem else mindPoems[mindPoems | length - 1] %}
{% set defaultLabel = "Today's poem" if todayPoem else "Latest poem — " ~ defaultPoem.day ~ " November 2026" %}

<p class="mind-poems__intro">One small poem a day, written by hand in the boxes of a calendar.</p>
<p class="poem-lang-link"><a href="https://jonathanmccallum-ja.pages.dev/mind-poems/">日本語で読む →</a></p>

<section class="mind-poems__today" aria-label="Today's poem">
  <p class="mind-poems__today-label" data-today-label data-default-label="{{ defaultLabel }}">{{ defaultLabel }}</p>
  {% for poem in mindPoems %}
  <article class="mind-poems__today-poem{% if poem.boxed %} mind-poems__today-poem--boxed{% endif %}" data-today-poem="{{ poem.day }}"{% if poem.day != defaultPoem.day %} hidden{% endif %}>
    <h2 class="mind-poems__today-day">{{ poem.day }} November 2026</h2>
    <p class="mind-poems__poem mind-poems__poem--today">{% for line in poem.lines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
  </article>
  {% endfor %}
  <p class="mind-poems__nav mind-poems__today-nav">
    <button type="button" data-today-prev>← Previous day</button>
    <button type="button" data-today-next>Next day →</button>
  </p>
</section>

<p class="mind-poems__calendar-link"><button type="button" class="mind-poems__calendar-toggle" data-calendar-toggle aria-expanded="false" aria-controls="mind-poems-calendar">View the full calendar</button></p>

<section class="mind-poems__calendar" id="mind-poems-calendar" aria-label="Full calendar">
<div class="mind-poems__grid" data-fade>
{% for day in range(1, 32) %}
{% set poem = none %}
{% for p in mindPoems %}{% if p.day == day %}{% set poem = p %}{% endif %}{% endfor %}
{% if poem %}
  <button type="button" class="mind-poems__day mind-poems__day--filled{% if poem.boxed %} mind-poems__day--boxed{% endif %}" data-poem="{{ poem.day }}" aria-label="{{ poem.day }} November 2026 poem — tap to read">
    <span class="mind-poems__dot" aria-hidden="true"></span>
  </button>
{% else %}
  <span class="mind-poems__day" aria-hidden="true"></span>
{% endif %}
{% endfor %}
</div>
</section>

{% for poem in mindPoems %}
{% set prev = mindPoems[loop.index0 - 1] if loop.index0 > 0 else none %}
{% set next = mindPoems[loop.index0 + 1] if loop.index0 < (mindPoems | length) - 1 else none %}
<dialog class="mind-poems__dialog" id="mind-poem-{{ poem.day }}" aria-labelledby="mind-poem-{{ poem.day }}-title">
  <button type="button" class="mind-poems__close" data-close aria-label="Close">×</button>
  <h2 id="mind-poem-{{ poem.day }}-title">{{ poem.day }} November 2026</h2>
  <p class="mind-poems__poem">{% for line in poem.lines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
  <p class="mind-poems__nav">
    <button type="button" data-open="{{ prev.day }}" {% if not prev %}disabled{% endif %}>← Previous</button>
    <button type="button" data-open="{{ next.day }}" {% if not next %}disabled{% endif %}>Next →</button>
  </p>
</dialog>
{% endfor %}

<p class="mind-poems__note">A new poem arrives one day at a time.</p>

---
layout: layouts/base.njk
---
{# Co-authored article layout — mirrors layouts/post.njk, with a byline
   naming both people, linking each one's social profile, and saying
   what each of them brought. The front matter carries:
   collaborator_name, collaborator_social (a profile link on Instagram,
   X, Threads, YouTube, Facebook or TikTok — checked by Bobby when the
   article is drafted), collaborator_role, jonathan_role.
   A collab article is never auto-published: Bobby drafts it
   (draft: true) only after Jonathan approves the proposal and the
   collaborator's account is verified. #}
<article>
  <h1>{{ title }}</h1>
  {% if page.date %}
  <p class="meta"><time datetime="{{ page.date.toISOString() }}">{{ page.date.toISOString().slice(0, 10) }}</time></p>
  {% endif %}
  {% if collaborator_name %}
  <section class="collab-byline" aria-label="Written together">
    <p class="collab-byline__title">Written together by <a href="{{ collaborator_social }}">{{ collaborator_name }}</a> and <a href="https://www.instagram.com/jonamccallum">Jonathan McCallum</a></p>
    {% if collaborator_role %}<p><strong>{{ collaborator_name }} brought:</strong> {{ collaborator_role }}</p>{% endif %}
    {% if jonathan_role %}<p><strong>Jonathan brought:</strong> {{ jonathan_role }}</p>{% endif %}
  </section>
  {% endif %}
  <div class="post-body">
  {{ content | safe }}
  </div>
</article>
{% set prevPost = collections.publishedPosts | getPreviousCollectionItem(page) %}
{% set nextPost = collections.publishedPosts | getNextCollectionItem(page) %}
{% if prevPost or nextPost %}
<nav class="post-nav" aria-label="More writing">
  {% if prevPost %}<a class="post-nav__prev" href="{{ prevPost.url }}">← {{ prevPost.data.title }}</a>{% endif %}
  {% if nextPost %}<a class="post-nav__next" href="{{ nextPost.url }}">{{ nextPost.data.title }} →</a>{% endif %}
</nav>
{% endif %}
{% include "comments.njk" %}

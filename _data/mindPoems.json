[{"boxed":false,"day":2,"lines":["Love is with","you, forever","you are free","in Jesus"]},{"boxed":false,"day":3,"lines":["The heather","fell and flaming","across the windy","meadow below"]},{"boxed":true,"day":4,"lines":["Sunlit shore, clean","roar, flame +","beauty forever","more"]},{"boxed":false,"day":5,"lines":["apple eaten","but not exactly","fruit digested","heaven on earth","lost or postponed","(turns) to the","creator."]},{"boxed":false,"day":6,"lines":["snow fall, light","low, all heavens","above and below","we sit in a world","so big"]},{"boxed":false,"day":7,"lines":["the clouds gather","yet they fall to","flow with the","tears of heaven"]}]
		<title>NFTs &#038; Jesus</title>
		<link>https://www.jonathanmccallum.com/2021/09/18/nfts-jesus/?utm_source=rss&#038;utm_medium=rss&#038;utm_campaign=nfts-jesus</link>
					<comments>https://www.jonathanmccallum.com/2021/09/18/nfts-jesus/#respond</comments>
		
		<dc:creator><![CDATA[Jonathan McCallum]]></dc:creator>
		<pubDate>Sat, 18 Sep 2021 04:06:07 +0000</pubDate>
				<category><![CDATA[Uncategorized]]></category>
